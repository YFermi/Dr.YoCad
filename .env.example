# Application
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://cadline:cadline_dev_password@localhost:5432/cadline?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (matches docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=cadline-files
S3_FORCE_PATH_STYLE=true

# JWT Secrets (replace with 32+ byte random secrets in production)
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Upload limits
MAX_UPLOAD_BYTES=524288000
UPLOAD_CHUNK_SIZE=5242880

# OAuth Stubs (populated in later sessions)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Optional AI Design Assistant (server-side only; never expose to browser)
# Leave blank to run Cadline with AI features cleanly disabled (503 AI_NOT_CONFIGURED).
GEMINI_API_KEY=

