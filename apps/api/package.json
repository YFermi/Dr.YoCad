{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./scripts/load-env.mjs src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=production --import ./scripts/load-env.mjs dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma": "node --import ./scripts/load-env.mjs node_modules/prisma/build/index.js",
    "seed": "tsx --import ./scripts/load-env.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.675.0",
    "@aws-sdk/s3-request-presigner": "^3.675.0",
    "@cadline/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "dxf-parser": "^1.1.2",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "occt-import-js": "^0.0.23",
    "pdfjs-dist": "^4.10.38",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx --import ./scripts/load-env.mjs prisma/seed.ts"
  }
}
